-- Version 5 -> 6: call sheet details. Crew contacts per job, unit base and parking notes, and a
-- reminder before call time (minutes before; 0 = off).
CREATE TABLE CrewContactEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    jobId INTEGER NOT NULL,
    name TEXT NOT NULL,
    role TEXT NOT NULL DEFAULT '',
    phone TEXT NOT NULL DEFAULT ''
);

CREATE INDEX CrewContactEntity_jobId ON CrewContactEntity(jobId);

ALTER TABLE JobEntity ADD COLUMN unitBase TEXT NOT NULL DEFAULT '';
ALTER TABLE JobEntity ADD COLUMN parking TEXT NOT NULL DEFAULT '';

ALTER TABLE SettingsEntity ADD COLUMN callReminderMinutes INTEGER NOT NULL DEFAULT 60;
