-- Single-row table holding app-wide defaults. defaultRate and monthlyBudget are minor units (fils);
-- monthlyBudget 0 means no budget. monthlyBudget and budgetAlerts were added in version 3 (migrations/2.sqm).
-- callReminderMinutes (version 6) is how long before call time to remind; 0 means off.
-- chaseReminders (version 7): remind weekly about overdue payments.
-- calendarSync (version 9): copy jobs into the phone's calendar.
-- appLock (version 10): ask for fingerprint or screen lock to open the app.
CREATE TABLE SettingsEntity (
    id INTEGER PRIMARY KEY CHECK (id = 1),
    defaultRate INTEGER NOT NULL,
    dayLengthHours REAL NOT NULL,
    otMultiplier REAL NOT NULL,
    paymentTermsDays INTEGER NOT NULL,
    currency TEXT NOT NULL,
    remindersEnabled INTEGER NOT NULL,
    monthlyBudget INTEGER NOT NULL DEFAULT 0,
    budgetAlerts INTEGER NOT NULL DEFAULT 1,
    callReminderMinutes INTEGER NOT NULL DEFAULT 60,
    chaseReminders INTEGER NOT NULL DEFAULT 1,
    calendarSync INTEGER NOT NULL DEFAULT 0,
    appLock INTEGER NOT NULL DEFAULT 0
);

INSERT INTO SettingsEntity(id, defaultRate, dayLengthHours, otMultiplier, paymentTermsDays, currency, remindersEnabled)
VALUES (1, 0, 10.0, 1.5, 30, 'AED', 1);

select:
SELECT * FROM SettingsEntity WHERE id = 1;

update:
UPDATE SettingsEntity SET
    defaultRate = ?, dayLengthHours = ?, otMultiplier = ?, paymentTermsDays = ?, currency = ?, remindersEnabled = ?,
    monthlyBudget = ?, budgetAlerts = ?, callReminderMinutes = ?, chaseReminders = ?, calendarSync = ?, appLock = ?
WHERE id = 1;
